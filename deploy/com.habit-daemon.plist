<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.habit-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/maxwellcollins/Developer/habit-daemon/dist/daemon/scheduler-daemon.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maxwellcollins/Developer/habit-daemon</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NODE_ENV</key>
        <string>production</string>
        <!-- Heartbeat file path. Default would land under the repo's
             .claude/state/ which is gitignored and may not exist; pin to
             ~/.habit-daemon/ alongside the env file + logs. -->
        <key>HABIT_HEARTBEAT_FILE</key>
        <string>/Users/maxwellcollins/.habit-daemon/heartbeat</string>
        <key>HABIT_STATE_DIR</key>
        <string>/Users/maxwellcollins/.habit-daemon</string>
        <!-- Application env vars (ANTHROPIC_API_KEY, DISCORD_BOT_TOKEN, the
             5 DISCORD_CHANNEL_* ids) are loaded by bootstrap.ts from
             ~/.habit-daemon/env at process start. -->
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/maxwellcollins/.habit-daemon/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/maxwellcollins/.habit-daemon/logs/stderr.log</string>
</dict>
</plist>
